/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
    };
    leds { // Trick to make enumeration work by toggling the D+ pin
        compatible = "gpio-leds";
        usb_dp: usb_dp {
            label = "USB D+ pin";
            gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
        };
    };
    // dap0: dap {
    //     compatible = "arm,cmsis-dap";
    //     status = "okay";
    //     clk-gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
    //     dio-gpios  = <&gpiob 14 GPIO_PULL_UP>;
    //     reset-gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
    //     port-write-cycles = <2>;
    // };

    dp0 {
        compatible = "zephyr,swdp-gpio";
//        compatible = "arm,cmsis-dap";
        status = "okay";
        clk-gpios = <&gpiob 13 GPIO_ACTIVE_HIGH>;
        dio-gpios  = <&gpiob 14 GPIO_PULL_UP>;
        reset-gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
        port-write-cycles = <2>;
    };
};

&usart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
};



&usbotg_fs {
    status = "okay";
    pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
    pinctrl-names = "default";

    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};


